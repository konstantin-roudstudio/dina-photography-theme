.plus-icon {
  background-color: #f2f0ec;
  border-radius: 50%;
  flex-shrink: 0;
  height: 32px;
  width: 32px;
  position: relative;

  @media (--tablet-up) {
    height: 40px;
    width: 40px;
  }

  &::before,
  &::after {
    background: currentColor;
    content: '';
    height: 1px;
    width: 18px;
    position: absolute;
    left: calc(50% - 9px);
    top: 50%;
    transition: all .2s ease;

    @media (--tablet-up) {
      width: 24px;
      left: calc(50% - 12px);
    }
  }

  &::after {
    transform: rotate(90deg);
  }
}